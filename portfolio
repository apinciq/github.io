<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aidan Pinciq — Portfolio</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #000;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .hidden {
      display: none !important;
    }

    /* MAIN MENU VIEW */
    #main-menu {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 48px 32px;
    }

    .content-section {
      display: flex;
      flex-direction: column;
      margin-top: 20px;
    }

    .section-label {
      font-size: 11px;
      text-transform: uppercase;
      color: #888;
      letter-spacing: 0.12em;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-label::after {
      content: "";
      height: 1px;
      width: 40px;
      background-color: #fff;
      opacity: 0.4;
    }

    .menu-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      list-style: none;
    }

    .menu-list li {
      font-size: 42px;
      font-weight: 600;
      line-height: 1.1;
      text-transform: uppercase;
      color: #aaa;
      cursor: pointer;
      transition: all 0.3s ease;
      width: fit-content;
    }

    .menu-list li:hover {
      color: #ffffff;
      transform: translateX(8px);
    }

    /* REEL / FEED VIEWS */
    .reel-view {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      position: relative;
      background: radial-gradient(circle at center, #111 0%, #000 70%);
    }

    .view-header {
      position: absolute;
      top: 28px;
      left: 32px;
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .back-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #fff;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      padding: 8px 16px;
      border-radius: 20px;
      transition: all 0.2s ease;
    }

    .back-btn:hover {
      background: #fff;
      color: #000;
    }

    /* Single-Video Scroll Snap Feed with Next Video Peak */
    .video-feed {
      height: 100vh;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 40px;
      padding-bottom: 120px;
    }

    .video-feed::-webkit-scrollbar {
      display: none;
    }

    /* Video Snap Card Setup */
    .video-card {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      flex-shrink: 0;
      width: 100vw;
      height: 85vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
      margin-bottom: 20px;
    }

    .card-inner {
      width: 85%;
      max-width: 520px;
      background-color: #0d0d0d;
      border: 2px solid #fff;
      padding: 12px;
      position: relative;
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.15);
      transition: transform 0.3s ease, border-color 0.3s ease, opacity 0.3s ease;
      opacity: 0.4;
    }

    .video-card.active .card-inner {
      transform: scale(1.02);
      border-color: #ffffff;
      box-shadow: 0 0 35px rgba(255, 255, 255, 0.35);
      opacity: 1;
    }

    .card-label {
      position: absolute;
      top: -12px;
      right: 14px;
      background: #fff;
      color: #000;
      font-size: 9px;
      font-weight: 800;
      padding: 3px 8px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-radius: 2px;
      z-index: 5;
    }

    .video-card video {
      width: 100%;
      height: auto;
      display: block;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* 16:9 Aspect Ratio Responsive Wrapper */
    .embed-container {
      position: relative;
      width: 100%;
      height: 0;
      padding-bottom: 56.25%;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .embed-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .video-title {
      margin-top: 12px;
      font-size: 11px;
      text-transform: uppercase;
      color: #fff;
      letter-spacing: 0.08em;
      font-weight: 500;
    }

    /* Scroll Down Indicator */
    .scroll-indicator {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      pointer-events: none;
      opacity: 0.8;
      transition: opacity 0.3s ease;
    }

    .scroll-indicator span {
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #fff;
    }

    .scroll-arrow {
      width: 12px;
      height: 12px;
      border-right: 2px solid #fff;
      border-bottom: 2px solid #fff;
      transform: rotate(45deg);
      animation: bounce 1.5s infinite;
    }

    @keyframes bounce {
      0%, 100% { transform: rotate(45deg) translate(0, 0); }
      50% { transform: rotate(45deg) translate(4px, 4px); }
    }

    /* PHOTOGRAPHY GRID */
    .photo-grid-container {
      height: 100vh;
      overflow-y: auto;
      padding: 100px 32px 40px 32px;
    }

    .photo-grid-container::-webkit-scrollbar {
      display: none;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .grid-post {
      position: relative;
      aspect-ratio: 1 / 1;
      background-color: #0d0d0d;
      border: 1px solid rgba(255, 255, 255, 0.2);
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .grid-post:hover {
      transform: scale(1.02);
      border-color: #fff;
    }

    .grid-post img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .carousel-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #fff;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 10px;
      letter-spacing: 0.05em;
    }

    .post-title {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.85));
      padding: 14px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #fff;
    }

    /* CAROUSEL MODAL OVERLAY */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.92);
      z-index: 100;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .close-modal {
      position: absolute;
      top: 24px;
      right: 32px;
      background: none;
      border: none;
      color: #fff;
      font-size: 28px;
      cursor: pointer;
      z-index: 101;
    }

    .modal-content {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 90%;
      max-width: 800px;
      height: 80vh;
    }

    .carousel-slide {
      position: relative;
      max-width: 100%;
      max-height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .carousel-slide img {
      max-width: 100%;
      max-height: 72vh;
      object-fit: contain;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .carousel-counter {
