      photoGalleries.forEach((gallery, index) => {
        const post = document.createElement('div');
        post.className = 'grid-post';
        post.onclick = () => openCarousel(index);

        post.innerHTML = `
          <img src="${gallery.coverImg}" alt="${gallery.folderName}">
          <div class="carousel-badge">❐ ${gallery.images.length}</div>
          <div class="post-title">${gallery.folderName}</div>
        `;
        gridContainer.appendChild(post);
      });
    }

    let currentGalleryIndex = 0;
    let currentImageIndex = 0;

    function openCarousel(galleryIndex) {
      currentGalleryIndex = galleryIndex;
      currentImageIndex = 0;
      updateCarouselImage();
      document.getElementById('carousel-modal').classList.remove('hidden');
    }

    function closeCarousel() {
      document.getElementById('carousel-modal').classList.add('hidden');
    }

    function changeSlide(direction) {
      const gallery = photoGalleries[currentGalleryIndex];
      currentImageIndex += direction;

      if (currentImageIndex < 0) {
        currentImageIndex = gallery.images.length - 1;
      } else if (currentImageIndex >= gallery.images.length) {
        currentImageIndex = 0;
      }

      updateCarouselImage();
    }

    function updateCarouselImage() {
      const gallery = photoGalleries[currentGalleryIndex];
      const imgElement = document.getElementById('carousel-img');
      const counterElement = document.getElementById('carouselCounter');

      imgElement.src = gallery.images[currentImageIndex];
      counterElement.innerText = `${currentImageIndex + 1} / ${gallery.images.length}`;
    }
