  <script src="https://www.youtube.com/iframe_api"></script>

  <script>
    const ytPlayers = {};

    function onYouTubeIframeAPIReady() {
      document.querySelectorAll('.yt-player').forEach(element => {
        const id = element.id;
        const videoId = element.getAttribute('data-video-id');

        ytPlayers[id] = new YT.Player(id, {
          videoId: videoId,
          playerVars: {
            autoplay: 0,
            controls: 1,
            rel: 0,
            modestbranding: 1,
            playsinline: 1
          }
        });
      });
    }

    function openPage(pageId) {
      document.getElementById('main-menu').classList.add('hidden');
      document.getElementById('ads-view').classList.add('hidden');
      document.getElementById('music-videos-view').classList.add('hidden');
      document.getElementById('photography-view').classList.add('hidden');

      const selectedPage = document.getElementById(pageId);
      if (selectedPage) {
        selectedPage.classList.remove('hidden');
      }

      if (pageId === 'main-menu') {
        pauseAllVideos();
      }
    }

    function pauseAllVideos() {
      document.querySelectorAll('video').forEach(v => v.pause());
      Object.values(ytPlayers).forEach(player => {
        if (player && typeof player.pauseVideo === 'function') {
          player.pauseVideo();
        }
      });
    }

    function setupScrollObserver(feedId) {
      const feed = document.getElementById(feedId);
      if (!feed) return;

      const cards = feed.querySelectorAll('.video-card');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target.querySelector('video');
          const ytContainer = entry.target.querySelector('.yt-player');

          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            
            if (video) {
              video.play().catch(() => {});
            }

            if (ytContainer && ytPlayers[ytContainer.id]) {
              const player = ytPlayers[ytContainer.id];
              if (typeof player.playVideo === 'function') {
                player.playVideo();
              }
            }
          } else {
            entry.target.classList.remove('active');

            if (video) {
              video.pause();
            }

            if (ytContainer && ytPlayers[ytContainer.id]) {
              const player = ytPlayers[ytContainer.id];
              if (typeof player.pauseVideo === 'function') {
                player.pauseVideo();
              }
            }
          }
        });
      }, {
        root: feed,
        threshold: 0.6
      });

      cards.forEach(card => observer.observe(card));
    }

    setupScrollObserver('adsFeed');
    setupScrollObserver('mvFeed');

